{
  "name": "hk-supermarket-watch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HK supermarket price comparison web app on Consumer Council Online Price Watch open data",
  "scripts": {
    "collect": "node server/collect.js",
    "start": "node server/index.js",
    "build": "vite build",
    "dev:client": "vite --port 5173",
    "dev:server": "node --watch server/index.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "node-cron": "^4.0.0",
    "react": "^19.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
